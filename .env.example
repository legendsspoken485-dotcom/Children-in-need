# ==========================================
# HOPEBRIDGE Environment Configuration
# ==========================================
# The core informational website, cause explorer, staged campaigns,
# interactive glass UI, and demonstration donation journey deploy
# without requiring third-party credentials.
#
# All variables below are OPTIONAL and documented for future production extensions.

# VITE_SITE_URL: Optional canonical URL of the deployed application (used for social meta tags and self-referential links)
# Default in development: http://localhost:3000
VITE_SITE_URL="https://hopebridge-charity.vercel.app"

# VITE_CONTACT_API_URL: Optional external webhook or serverless endpoint to receive contact messages.
# If unset, inquiries are validated client-side with simulated authoritative ticket confirmation.
VITE_CONTACT_API_URL=""

# VITE_STRIPE_PUBLIC_KEY: Optional public key for live Stripe payment integration.
# When omitted, the donation journey operates in fully functional, clearly labeled Demonstration Mode.
VITE_STRIPE_PUBLIC_KEY=""
